{
  "fastapi-router": {
    "prefix": [
      "fast-routes"
    ],
    "body": [
      "from fastapi import APIRouter, FastAPI",
      "",
      "",
      "router = APIRouter(prefix=\"/v1/$1\", tags=[\"$1\"])",
      "",
      "",
      "def init_app(app: FastAPI) -> None:",
      "    app.include_router(router)",
      "",
      "",
      "$0"
    ]
  },
  "async-main": {
    "prefix": [
      "a-main"
    ],
    "body": [
      "import asyncio",
      "",
      "",
      "async def main() -> None:",
      "    ${0:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    asyncio.run(main())"
    ]
  }
}
